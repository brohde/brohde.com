/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://us-assets.i.posthog.com https://challenges.cloudflare.com; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com; object-src 'none'; upgrade-insecure-requests

# Hashed, immutable build assets (JS chunks; the stylesheet is inlined into each
# document <head> via astro.config build.inlineStylesheets, so there is no
# _astro CSS request to cache here). Content hash in the filename -> cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Non-hashed static assets keep stable URLs, so they can't be "immutable" (an
# update reuses the same path). Give them a real cache with revalidation so
# repeat views skip the download while a redeploy still lands promptly.
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/robots.txt
  Cache-Control: public, max-age=3600
