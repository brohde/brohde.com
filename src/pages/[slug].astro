---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroBand from "@/components/HeroBand.astro";
import Scene from "@/components/Scene.astro";
import { SITE, logHref, logStamp, isoDate } from "@/lib/site";

/**
 * Article page, #67 C variant: editorial reading surface (Circular via
 * .prose/.atitle) on the system ground; every terminal moment is a piece of
 * the phosphor screen (the homechips, the hero band, pre excerpts).
 * SEO/JSON-LD/RSS behavior unchanged; internal navigation rides the #150
 * tide transition (scene persists and travels identity, reading column
 * cross-fades; see global.css).
 *
 * Interior scene (B2 P3/B3): every article mounts the one persistent scene
 * (#109: content left, right gutter preserved) wearing the article's OWN
 * identity (#111): theme from frontmatter picks the sky, tide peak, and
 * mark (see PEAKS/THEME_SOURCE in src/scripts/scene/index.ts). The section
 * below also stamps data-scene-theme for the terminal.ts bridge: the scene
 * DOM carries transition:persist, so on client-side navigations the OLD
 * page's node survives and props alone cannot flip identity; the bridge
 * reads the stamp from this fresh, non-persisted element and travels the
 * scene there. The hero band (#97/#103) presents the same identity's mark
 * large at the top of the article.
 */
export async function getStaticPaths() {
  // External entries live off-site: no page is generated for them. Item 11:
  // only PUBLISHED articles generate a page, so every unpublished article URL
  // 404s on the built site.
  // #188: unpublished internal articles DO generate a page again, as a
  // "Coming soon" stub wearing the article's full scene identity, so the
  // matrix travel is live end to end while the writing stays offline. Stubs
  // are noindex and carry no JSON-LD; RSS stays published-only.
  const posts = await getCollection(
    "articles",
    ({ data }) => !data.draft && !data.external
  );
  // #179: articles serve at bare root slugs, so an article slug must never
  // shadow a real page. Fail the build loudly instead of silently winning or
  // losing the route race. "log" stays reserved for the /log/* 301s.
  const RESERVED = new Set([
    "about",
    "chat",
    "styleguide",
    "404",
    "index",
    "rss.xml",
    "api",
    "log",
  ]);
  for (const post of posts) {
    if (RESERVED.has(post.id) || post.id.includes("/")) {
      throw new Error(
        `Article slug "${post.id}" collides with a reserved route (#179 bare-slug URLs). Rename the article folder.`
      );
    }
  }
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
// a stub renders no body, so the content pipeline only runs for real articles
const isStub = !post.data.published;
const { Content } = isStub ? { Content: null } : await render(post);
const { title, description, date, stats, theme } = post.data;

const canonical = new URL(logHref(post.id), SITE.url).href;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  ...(description ? { description } : {}),
  datePublished: isoDate(date),
  dateModified: isoDate(date),
  author: { "@type": "Person", name: SITE.author, url: SITE.url },
  publisher: { "@type": "Person", name: SITE.author },
  mainEntityOfPage: canonical,
  url: canonical,
};
---

<BaseLayout
  title={title}
  description={description ?? SITE.description}
  ogType="article"
  jsonLd={isStub ? undefined : articleLd}
  noindex={isStub}
>
  <Scene theme={theme} />
  <section
    class="screen"
    data-screen="log"
    data-scene-theme={theme}
    tabindex="-1"
  >
    {
      /* B2 Phase 1: the .atop chrome bar is retired; the global header is
        the one frame on every page. The .aend chips keep their no-aria-label
        convention: the visible command word IS the accessible name. */
    }
    <div class="wrap artpad">
      <HeroBand seed={post.id} theme={theme} />

      <main id="main">
        <article>
          <p class="adate">
            <time datetime={isoDate(date)}>{logStamp(date)}</time>{" "}
            <span aria-hidden="true">·</span> log
          </p>
          <h1 class="atitle">{title}</h1>

          {
            !isStub && stats && (
              <div class="astats" role="group" aria-label="Key numbers">
                {stats.map((s) => (
                  <div class="astat">
                    <span class="n">{s.n}</span>
                    <span class="l">{s.label}</span>
                  </div>
                ))}
              </div>
            )
          }

          <div class="prose" style="margin-top:0">
            {isStub ? (
              <p>Coming soon.</p>
            ) : (
              <>
                {description && <p>{description}</p>}
                {Content && <Content />}
              </>
            )}
          </div>
        </article>

        <footer class="aend">
          <a class="homechip" href="/">
            <span class="br" aria-hidden="true">[</span>home<span
              class="br"
              aria-hidden="true">]</span
            >
          </a>
          <a class="homechip" href="/#log">
            <span class="br" aria-hidden="true">[</span>log<span
              class="br"
              aria-hidden="true">]</span
            >
          </a>
        </footer>
        {
          /* The Android robot in this page's scene is CC BY 3.0 (Google
            brand guidelines); the user-visible attribution the license
            requires rides the theme wiring, so it can never detach from
            the identity it credits (#135 follow-up). */
        }
        {
          theme === "android" && (
            <p class="attrib">
              The Android robot in this page's background is reproduced or
              modified from work created and shared by Google and used
              according to terms described in the Creative Commons 3.0
              Attribution License.
            </p>
          )
        }
      </main>
    </div>
  </section>
</BaseLayout>
