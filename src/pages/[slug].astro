---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Scene from "@/components/Scene.astro";
import ArticleNav from "@/components/ArticleNav.astro";
import { SITE, logHref, isoDate } from "@/lib/site";
import { articleLd, breadcrumbLd } from "@/lib/schema";
import { articleChain, neighborsOf } from "@/lib/articles";

/**
 * Article page, #67 C variant: editorial reading surface (Circular via
 * .prose/.atitle) on the system ground; the phosphor screen survives only in
 * pre excerpts now (the bracket chips are retired site-wide, Option C
 * 2026-07-21). Articles carry only the background Scene, like the homepage and
 * About (the top matrix hero band is retired).
 * SEO/JSON-LD/RSS behavior unchanged; internal navigation rides the #150
 * tide transition (scene persists and travels identity, reading column
 * cross-fades; see global.css).
 *
 * Interior scene (B2 P3/B3): every article mounts the one persistent scene
 * (#109: content left, right gutter preserved) wearing the article's OWN
 * identity (#111): theme from frontmatter picks the sky, tide peak, and
 * mark (see PEAKS/THEME_SOURCE in src/scripts/scene/index.ts). The section
 * below also stamps data-scene-theme for the terminal.ts bridge: the scene
 * DOM carries transition:persist, so on client-side navigations the OLD
 * page's node survives and props alone cannot flip identity; the bridge
 * reads the stamp from this fresh, non-persisted element and travels the
 * scene there.
 */
export async function getStaticPaths() {
  // External entries live off-site: no page is generated for them. Item 11:
  // only PUBLISHED articles generate a page, so every unpublished article URL
  // 404s on the built site.
  // #188: unpublished internal articles DO generate a page again, as a
  // "Coming soon" stub wearing the article's full scene identity, so the
  // matrix travel is live end to end while the writing stays offline. Stubs
  // are noindex and carry no JSON-LD; RSS stays published-only.
  // The generated set and the prev/next chain are the SAME list (both are
  // internal, non-draft articles in ledger order), so they can never drift.
  const chain = await articleChain();
  // #179: articles serve at bare root slugs, so an article slug must never
  // shadow a real page. Fail the build loudly instead of silently winning or
  // losing the route race. "log" stays reserved for the /log/* 301s.
  const RESERVED = new Set([
    "about",
    "chat",
    "contact",
    "credits",
    "styleguide",
    "404",
    "index",
    "rss.xml",
    "api",
    "log",
  ]);
  for (const post of chain) {
    if (RESERVED.has(post.id) || post.id.includes("/")) {
      throw new Error(
        `Article slug "${post.id}" collides with a reserved route (#179 bare-slug URLs). Rename the article folder.`
      );
    }
  }
  // Prev/next neighbors ride along as props: "newer" = the entry above in the
  // ledger, "older" = below (null at the ends). External entries never enter
  // the chain, so a hop over one lands on the next real page.
  return chain.map((post) => {
    const { newer, older } = neighborsOf(chain, post.id);
    return { params: { slug: post.id }, props: { post, newer, older } };
  });
}

const { post, newer, older } = Astro.props;
// a stub renders no body, so the content pipeline only runs for real articles
const isStub = !post.data.published;
const { Content } = isStub ? { Content: null } : await render(post);

// Image assets publish ahead of the text (Brian, 2026-07-21): a stub shows
// the article's own figures, sourced from the body's figure blocks so alt
// text + captions stay single-sourced in the markdown.
const ARTICLE_IMAGES = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/articles/*/*.{png,jpg,jpeg,webp,gif}",
  { eager: true }
);
type StubFig =
  | { kind: "img"; img: ImageMetadata; alt: string; caption: string; cls?: string }
  | {
      kind: "video";
      src: string;
      poster?: string;
      label: string;
      caption: string;
      cls?: string;
      auto?: boolean;
    };
const stubFigs: StubFig[] = [];
if (isStub && post.body) {
  for (const b of post.body.matchAll(
    /<figure(?:\s+class="([^"]*)")?>([\s\S]*?)<\/figure>/g
  )) {
    const cls = b[1];
    const block = b[2];
    const caption =
      block.match(/<figcaption>([\s\S]*?)<\/figcaption>/)?.[1]?.trim() ?? "";
    const img = block.match(/!\[([^\]]*)\]\(\.\/([^)]+)\)/);
    if (img) {
      const mod = ARTICLE_IMAGES[`/src/content/articles/${post.id}/${img[2]}`];
      if (mod)
        stubFigs.push({
          kind: "img",
          img: mod.default,
          alt: img[1],
          caption,
          cls,
        });
      continue;
    }
    const vid = block.match(/<video[^>]*\bsrc="([^"]+)"[^>]*>/);
    if (vid) {
      stubFigs.push({
        kind: "video",
        src: vid[1],
        poster: block.match(/\bposter="([^"]+)"/)?.[1],
        label: block.match(/\baria-label="([^"]+)"/)?.[1] ?? "",
        // silent captures may autoplay (muted loop rides along with it)
        auto: /\bautoplay\b/.test(vid[0]),
        caption,
        cls,
      });
    }
  }
}
const { title, description, date, stats, theme } = post.data;

const canonical = new URL(logHref(post.id), SITE.url).href;

// Per-article social share media. Two paths, keyed off the FIRST <video> in
// the body (works for both full-prose articles and stubs, whose figure blocks
// wrap the same <video>):
//   video article -> og:video (playable in iMessage/Facebook) + the poster as
//                    og:image (the universal fallback X/LinkedIn actually use).
//   no-video      -> the generated 1200x630 glyph card at /share/<slug>.png.
// Video pixel dimensions come from ffprobe and are kept HERE because the
// Cloudflare build machine has no ffprobe and the freshness check stays pure
// node; a new video must add its entry (keyed by media filename). The poster
// carries no og:image dimension metadata: a poster is not guaranteed to share
// the video's aspect, and og:image alone unfurls fine.
const SHARE_VIDEO_META: Record<string, { width: number; height: number }> = {
  newsroom: { width: 1440, height: 1048 },
  afw: { width: 1440, height: 1070 },
  "signal-pong": { width: 1440, height: 810 },
};

const firstVideo = post.body?.match(/<video[^>]*\bsrc="([^"]+)"[^>]*>/);
let shareImage = `/share/${post.id}.png`;
let shareImageMeta:
  | { width: number; height: number; type?: string; alt?: string }
  | undefined = {
  width: 1200,
  height: 630,
  type: "image/png",
  alt: `${title}, rendered as the article's terminal glyph card`,
};
let shareVideo:
  | { url: string; type?: string; width: number; height: number }
  | undefined;

if (firstVideo) {
  const src = firstVideo[1];
  const poster = firstVideo[0].match(/\bposter="([^"]+)"/)?.[1];
  if (poster) shareImage = poster;
  shareImageMeta = undefined; // poster brings no dimension metadata (see above)
  const base = src.replace(/^.*\//, "").replace(/\.[^.]+$/, "");
  const dims = SHARE_VIDEO_META[base];
  if (dims) shareVideo = { url: src, width: dims.width, height: dims.height };
}

// JSON-LD (src/lib/schema.ts). BlogPosting always; BreadcrumbList (A2: home >
// this article) alongside it. Both ship only on real articles; stubs stay
// JSON-LD-free and noindex (see the jsonLd prop gate below).
const articleSchema = articleLd({ title, description, date, canonical });
const breadcrumbSchema = breadcrumbLd({ title, canonical });
---

<BaseLayout
  title={title}
  description={description ?? SITE.description}
  ogType="article"
  image={shareImage}
  imageMeta={shareImageMeta}
  video={shareVideo}
  jsonLd={isStub ? undefined : [articleSchema, breadcrumbSchema]}
  noindex={isStub}
>
  <Scene theme={theme} />
  <section
    class="screen"
    data-screen="log"
    data-scene-theme={theme}
    tabindex="-1"
  >
    {
      /* B2 Phase 1: the .atop chrome bar is retired; the global header is
        the one frame on every page. The single top affordance is the "log"
        archive-return link inside the .adate line; full prev/next lives at
        the bottom where the titles are. */
    }
    <div class="wrap artpad">
      <main id="main">
        <article>
          <p class="adate">
            <time datetime={isoDate(date)}>{isoDate(date)}</time>
          </p>
          <h1 class="atitle">{title}</h1>

          {
            !isStub && stats && (
              <div class="astats" role="group" aria-label="Key numbers">
                {stats.map((s) => (
                  <div class="astat">
                    <span class="n">{s.n}</span>
                    <span class="l">{s.label}</span>
                  </div>
                ))}
              </div>
            )
          }

          <div class="prose" style="margin-top:0">
            {isStub ? (
              <>
                {stubFigs.map((f) => (
                  <figure class={f.cls}>
                    {/* media wrapped in <p> to mirror the markdown pipeline's
                        output, so the .prose figure > p:has() plate rules
                        (and the portrait cap) style stubs identically */}
                    <p>
                      {f.kind === "img" ? (
                        <Image
                          src={f.img}
                          alt={f.alt}
                          widths={[320, 640, 960, 1280]}
                          sizes="(max-width: 700px) 92vw, 660px"
                        />
                      ) : (
                        <video
                          src={f.src}
                          poster={f.poster}
                          controls
                          autoplay={f.auto}
                          muted={f.auto}
                          loop={f.auto}
                          preload="metadata"
                          playsinline
                          aria-label={f.label}
                        />
                      )}
                    </p>
                    {/* captions are repo-authored markup (may carry links) */}
                    <figcaption set:html={f.caption} />
                  </figure>
                ))}
              </>
            ) : (
              <>
                {description && <p>{description}</p>}
                {Content && <Content />}
              </>
            )}
          </div>
        </article>

        {/* Primary (and only) prev/next nav: full titles, the de facto
            article footer above the global footer. */}
        <ArticleNav newer={newer} older={older} />

        {
          /* The [home]/[log] chips + their rule are GONE from articles
            (Brian, 2026-07-21): the wordmark is the way home and the
            newer/older nav is the onward path. The Android robot's CC BY 3.0
            attribution (#135) lives on /credits (the page stays live;
            the footer link to it was removed 2026-07-22). */
        }
      </main>
    </div>
  </section>
</BaseLayout>
