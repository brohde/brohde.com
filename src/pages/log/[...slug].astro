---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TideBand from "@/components/TideBand.astro";
import { SITE, logHref, logStamp, isoDate } from "@/lib/site";

/**
 * Article page, #67 C variant: editorial reading surface (Circular via
 * .prose/.atitle) on the system ground; every terminal moment is a piece of
 * the phosphor screen (the homechips, the tide band facade, pre excerpts).
 * SEO/JSON-LD/RSS behavior unchanged from the previous layout; internal
 * navigation keeps the wipe (#64, articles are never a morph pair).
 */
export async function getStaticPaths() {
  // External entries live off-site: no page is generated for them.
  const posts = await getCollection(
    "articles",
    ({ data }) => !data.draft && !data.external
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, stats } = post.data;

const canonical = new URL(logHref(post.id), SITE.url).href;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  ...(description ? { description } : {}),
  datePublished: isoDate(date),
  dateModified: isoDate(date),
  author: { "@type": "Person", name: SITE.author, url: SITE.url },
  publisher: { "@type": "Person", name: SITE.author },
  mainEntityOfPage: canonical,
  url: canonical,
};
---

<BaseLayout
  title={title}
  description={description ?? SITE.description}
  ogType="article"
  jsonLd={articleLd}
>
  <section class="screen" data-screen="log" tabindex="-1">
    <div class="wrap artpad">
      <div class="atop">
        {
          /* no aria-label overrides on the chips: the visible command word IS
            the accessible name (brackets are aria-hidden), so speech-input
            users can say what they see */
        }
        <a class="homechip" href="/">
          <span class="br" aria-hidden="true">[</span>home<span
            class="br"
            aria-hidden="true">]</span
          >
        </a>
        <span class="tbl">brohde.com/log</span>
      </div>

      <TideBand seed={post.id} />

      <main id="main">
        <article>
          <p class="adate">
            <time datetime={isoDate(date)}>{logStamp(date)}</time>{" "}
            <span aria-hidden="true">·</span> build.log
          </p>
          <h1 class="atitle">{title}</h1>

          {
            stats && (
              <div class="astats" role="group" aria-label="Key numbers">
                {stats.map((s) => (
                  <div class="astat">
                    <span class="n">{s.n}</span>
                    <span class="l">{s.label}</span>
                  </div>
                ))}
              </div>
            )
          }

          <div class="prose" style="margin-top:0">
            {description && <p>{description}</p>}
            <Content />
          </div>
        </article>

        <footer class="aend">
          <a class="homechip" href="/">
            <span class="br" aria-hidden="true">[</span>home<span
              class="br"
              aria-hidden="true">]</span
            >
          </a>
          <a class="homechip" href="/#log">
            <span class="br" aria-hidden="true">[</span>build.log<span
              class="br"
              aria-hidden="true">]</span
            >
          </a>
        </footer>
      </main>
    </div>
  </section>
</BaseLayout>
