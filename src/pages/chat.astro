---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChatPanel from "@/components/ChatPanel.astro";

/**
 * /chat, a normal page in the global shell (#108). The surface (Scene + the
 * .screen section + docked ChatBar composer + transcript + [clear] keybar) is
 * the shared ChatPanel, so /chat and /contact can never drift. Phase 4B: the
 * composer docks INTO the phosphor panel as its top edge, the transcript flows
 * NEWEST FIRST (terminal.ts beginTurn), and terminal.ts injects a time-of-day
 * greeting into the empty log when the panel is pristine. The panel gets a
 * min-height that extends it to ~28px above the viewport bottom on load; long
 * content grows the panel and the page scrolls (no internal scroll region).
 * noindex: a functional surface, not indexable content.
 */
---

<BaseLayout
  title="Chat"
  description="Ask about Brian Rohde’s work. Answers come from a live model."
  noindex={true}
>
  <ChatPanel screenId="scr-chat" label="Chat" />
</BaseLayout>
