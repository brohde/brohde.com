---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404" noindex={true}>
  <section class="screen" data-screen="404" tabindex="-1">
    {
      /* B2 Phase 1: .atop chrome retired; the global header is the frame.
        The prompt the copy mentions is now really on this page (the header
        input). */
    }
    <div class="wrap artpad">
      <main id="main">
        <h1 class="atitle">Command not found</h1>
        <p class="prose" style="margin-top:0">
          That page is not on the log. Head home and browse the work, or ask a
          question at the prompt.
        </p>
        <footer class="aend">
          <a class="homechip" href="/">
            <span class="br" aria-hidden="true">[</span>home<span
              class="br"
              aria-hidden="true">]</span
            >
          </a>
          <a class="homechip" href="/#log">
            <span class="br" aria-hidden="true">[</span>log<span
              class="br"
              aria-hidden="true">]</span
            >
          </a>
        </footer>
      </main>
    </div>
  </section>
</BaseLayout>
