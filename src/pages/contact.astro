---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChatPanel from "@/components/ChatPanel.astro";

/**
 * /contact, a dedicated entry into the in-chat contact flow (fixbatch Phase 2).
 * The surface is the SAME joined object as /chat, rendered through the shared
 * ChatPanel; the one addition is `arm`, which stamps data-contact-arm on the
 * section. initPage reads it (on load and on every astro:page-load refresh) and
 * arms the contact flow with the time-of-day greeting as the newest turn instead
 * of the pristine chat greeting. There is no fake user echo. If a thread was
 * rehydrated (visitor arrived mid-session) it stays below the greeting. The nav
 * item / typed `contact` / open_page:contact entries are untouched and still
 * play their emulation on /chat.
 *
 * noindex like /chat: a functional entry point, not indexable content.
 */
---

<BaseLayout
  title="Contact"
  description="Send Brian a message. His AI helps you write it."
  noindex={true}
>
  <ChatPanel screenId="scr-contact" label="Contact" arm />
</BaseLayout>
