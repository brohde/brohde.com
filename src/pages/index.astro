---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChatBar from "@/components/ChatBar.astro";
import HomeIntro from "@/components/HomeIntro.astro";
import Scene from "@/components/Scene.astro";
import ArticleLog from "@/components/ArticleLog.astro";
import { SITE, LINKS, COMPANIES } from "@/lib/site";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.author,
  url: SITE.url,
  jobTitle: "AI Product Engineer",
  email: `mailto:${SITE.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "San Francisco",
    addressRegion: "CA",
    addressCountry: "US",
  },
  sameAs: [LINKS.linkedin, LINKS.x, COMPANIES.eightAngle],
  knowsAbout: [
    "Machine learning",
    "iOS development",
    "Astro",
    "Web performance",
    "AI-assisted engineering",
  ],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  author: { "@type": "Person", name: SITE.author },
};
---

<BaseLayout ogType="profile" jsonLd={[person, website]}>
  {
    /* ambient scene (#106/#114): fixed background layer, facade-first (#70).
    Homepage identity: default palette, the BR letterform (Scene.astro
    defaults; the theme's own mark, #111/#135). */
  }
  <Scene />
  <section class="screen" id="scr-home" data-screen="home" tabindex="-1">
    <div class="wrap homepad">
      <main id="main">
        <HomeIntro />
        {
          /* The flow chat bar (#160): the slab's successor. The same input
          material as the header row (ChatBar.astro), condensed, in the
          reading flow between the identity block and the ledger; a send
          navigates to /chat with the question carried (pendingAfter). The
          hint line beneath is the quiet feedback surface (hint() in
          terminal.ts): command nudges and the one-time cursor hint. */
        }
        <ChatBar
          inputId="in-home"
          class="flowchat"
          placeholder="Ask Brian's AI anything"
        />
        <p class="cmt hint" id="hint-top" aria-live="polite"></p>
        <ArticleLog />
      </main>
    </div>
  </section>
</BaseLayout>
