---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EditorialHeader from "@/components/EditorialHeader.astro";
import Slab from "@/components/Slab.astro";
import ArticleLog from "@/components/ArticleLog.astro";
import { SITE, LINKS, COMPANIES } from "@/lib/site";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.author,
  url: SITE.url,
  jobTitle: "AI Product Engineer",
  email: `mailto:${SITE.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "San Francisco",
    addressRegion: "CA",
    addressCountry: "US",
  },
  sameAs: [LINKS.linkedin, LINKS.x, COMPANIES.eightAngle],
  knowsAbout: [
    "Machine learning",
    "iOS development",
    "Astro",
    "Web performance",
    "AI-assisted engineering",
  ],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  author: { "@type": "Person", name: SITE.author },
};
---

<BaseLayout ogType="profile" jsonLd={[person, website]}>
  <section class="screen" id="scr-home" data-screen="home" tabindex="-1">
    <div class="wrap homepad">
      <EditorialHeader />

      <main id="main">
        <Slab promptId="home" />
        <ArticleLog boot />
      </main>

      <footer class="status bseq">
        Status: open to full time roles + freelance
      </footer>
      <p class="cmt proto bseq"># brohde.com</p>
    </div>
  </section>
</BaseLayout>
