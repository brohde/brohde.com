---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProfileLinks from "@/components/ProfileLinks.astro";

// Specimen page (D4 pattern). Forces both grounds side by side regardless of
// system scheme, so a token change can be eyeballed in light and dark at once.
// The slab specimen renders IDENTICALLY in both panels: it scopes its own
// fixed night tokens (#67), which is exactly the point.
// noindex + excluded from the sitemap.

const swatches = [
  { name: "ground", desc: "page background" },
  { name: "ink", desc: "body text" },
  { name: "bright", desc: "headings / strong" },
  { name: "dim", desc: "muted / metadata" },
  { name: "accent", desc: "phosphor / links" },
  { name: "line", desc: "hairline" },
  { name: "line-strong", desc: "stronger hairline" },
  { name: "well", desc: "input / code well" },
];

const themes = [
  { cls: "theme-night", label: "night (dark)" },
  { cls: "theme-light", label: "light" },
];
---

<BaseLayout title="styleguide" noindex={true}>
  <section class="screen" data-screen="styleguide" tabindex="-1">
    <main id="main" class="wrap aboutpad">
      <h1 class="arttitle">styleguide</h1>
      <p class="cmt">
        # design tokens + component specimens in both grounds (#40). The slab
        is always night (#67). Noindex, out of the sitemap.
      </p>

      {
        themes.map((t) => (
          <div class={`sg-panel ${t.cls}`}>
            <p class="sg-panel-label">{t.label}</p>

            <h2 class="sg-h">tokens</h2>
            <div class="sg-swatches">
              {swatches.map((s) => (
                <div class="sg-swatch">
                  <span
                    class="sg-chip"
                    style={`background: var(--${s.name})`}
                  />
                  <span class="sg-swatch-meta">
                    <code>--{s.name}</code>
                    <span class="d">{s.desc}</span>
                  </span>
                </div>
              ))}
            </div>

            <h2 class="sg-h">global header</h2>
            {/* static specimen: no ids, no form, no data-cmd, so it can
                never collide with the real header BaseLayout renders */}
            <div class="shead" style="padding:0">
              <div class="idrow">
                <p class="wmrow">
                  <span class="wm">
                    brian rohde
                    <span class="caret" aria-hidden="true" />
                  </span>
                </p>
                <span class="snav">
                  <span class="snav-spec">about</span>
                  <span class="snav-spec">contact</span>
                </span>
              </div>
              <div class="hchat">
                <span class="p" aria-hidden="true">
                  $
                </span>
                <span style="color:#8fa79a;font-size:16px">
                  Ask me anything or type help
                </span>
              </div>
            </div>

            <h2 class="sg-h">editorial identity</h2>
            <div class="cid" style="padding-top:0">
              <div class="crole">
                <span class="crole-txt">
                  AI Product Engineer <span class="d">·</span> San Francisco
                </span>
                <span class="d" aria-hidden="true">·</span>
                <ProfileLinks />
              </div>
              <p class="cco">
                Founder, <a href="#">Eight Angle</a>
              </p>
              <p class="cco">
                <span class="d">Prev:</span> <a href="#">Gong</a>{" "}
                <span class="d">·</span> <a href="#">Twilio</a>{" "}
                <span class="d">·</span> <a href="#">Facebook</a> +{" "}
                <a href="#">Google</a> <span class="cnote">(contract)</span>
              </p>
            </div>

            <h2 class="sg-h">the slab (always night, both grounds)</h2>
            <div class="slab" style="margin-top:0">
              <div class="slabhead">
                <span>brohde.com · chat</span>
                <span class="ccstat">
                  <span class="dot" aria-hidden="true" />
                  ready
                </span>
              </div>
              <div class="slabbody">
                <p class="slabhello">
                  <span class="p">$</span> hello
                </p>
                <div class="menu">
                  {["work", "about", "resume", "contact"].map((c) => (
                    <span class="cbtn">
                      <span class="br">[</span>
                      <span class="lbl">{c}</span>
                      <span class="br">]</span>
                    </span>
                  ))}
                </div>
                <div class="promptzone">
                  <div class="prompt">
                    <span class="p">$</span>
                    <span class="iwrap">
                      <span style="color:var(--dim);font-size:16px">
                        Ask me anything or type help
                      </span>
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <h2 class="sg-h">ledger entries</h2>
            <div class="clog" style="margin-top:0">
              <span class="lentry">
                <span class="lts">2026-02-12</span>
                <span class="lttl">
                  Eight Angle: a 47-class yoga pose classifier that runs
                  on-device
                </span>
              </span>
              <span class="lentry">
                <span class="lts">2018-10-25</span>
                <span class="lttl">
                  Twilio Hackpack v4: co-authoring the open source hardware
                  badge post
                  <span class="extmark">
                    <span class="ext" aria-hidden="true">
                      &#8599;
                    </span>
                    <span class="extdom">twilio.com</span>
                  </span>
                </span>
              </span>
            </div>

            <h2 class="sg-h">autocomplete</h2>
            <div class="promptzone" style="margin-bottom:14px">
              <div class="ac" style="position:static;margin-bottom:8px">
                <p class="ac-head">Commands · tab to accept · ↑↓ to cycle</p>
                <ul class="ac-list">
                  <li class="ac-chip" aria-selected="true">
                    <span>work</span>
                    <span class="ac-desc">Browse the log</span>
                  </li>
                  <li class="ac-chip">
                    <span>about</span>
                    <span class="ac-desc">Who I am</span>
                  </li>
                </ul>
              </div>
              <div class="prompt">
                <span class="p">$</span>
                <span class="iwrap">
                  <span style="color:var(--bright);font-size:16px">wor</span>
                </span>
              </div>
            </div>

            <h2 class="sg-h">prose</h2>
            <div class="prose" style="margin-top:0">
              <p>
                Body copy sets in the editorial face. Metric-first, plain nouns:
                47-class classifier at 92.2% accuracy, roughly 20fps on-device.
              </p>
            </div>
          </div>
        ))
      }
    </main>
  </section>
</BaseLayout>

<style is:global>
  /* Force each ground explicitly so the specimen ignores system scheme. */
  .theme-night {
    --ground: #0e1512;
    --ink: #d6e5dc;
    --bright: #f2f7f3;
    --dim: #8fa79a;
    --accent: #7ee787;
    --on-accent: #0e1512;
    --line: #2e4a3c;
    --line-strong: #33523f;
    --well: #12201a;
    color-scheme: dark;
  }
  .theme-light {
    --ground: #fbfbf8;
    --ink: #14211a;
    --bright: #14211a;
    --dim: #3f5348;
    --accent: #086148;
    --on-accent: #fbfbf8;
    --line: #dae0d6;
    --line-strong: #c7d0c4;
    --well: #f1f2ec;
    color-scheme: light;
  }
  .sg-panel {
    background: var(--ground);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 20px;
    margin: 16px 0;
  }
  .sg-panel-label {
    font-size: 12px;
    color: var(--dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .sg-h {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
    border-top: 1px solid var(--line);
    padding-top: 14px;
    margin: 22px 0 10px;
  }
  .sg-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }
  .sg-swatch {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sg-chip {
    width: 34px;
    height: 34px;
    border-radius: 6px;
    border: 1px solid var(--line);
    flex: none;
  }
  .sg-swatch-meta {
    display: flex;
    flex-direction: column;
    font-size: 12px;
  }
  .sg-swatch-meta code {
    color: var(--ink);
  }
</style>
