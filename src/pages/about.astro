---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Scene from "@/components/Scene.astro";
import { COMPANIES } from "@/lib/site";
import { profilePageLd } from "@/lib/schema";

const description =
  "Brian Rohde is a Design Engineer in San Francisco. He led web platforms at Gong and Twilio alongside design teams, and now builds Eight Angle and client sites.";

const profilePage = profilePageLd();
---

<BaseLayout title="About" description={description} jsonLd={profilePage}>
  {
    /* interior scene (B2 P3): the persistent gutter scene on the default
    BR identity (#109/#111); content keeps the left column, the wrap
    left-anchors at gutter widths via body:has(.scene) (#125/#126). */
  }
  <Scene />
  <section class="screen" id="scr-about" data-screen="about" tabindex="-1">
    {
      /* B2 Phase 1: the .atop chrome bar ([home] chip + path label) is
        retired; the global header is the one frame on every page. The way
        home is the header wordmark; the page ends clean (Option C,
        2026-07-21) and the global footer follows, matching articles. */
    }
    <div class="wrap artpad">
      <main id="main">
        <h1 class="atitle">About</h1>
        <article class="prose" style="margin-top:0">
          {
            /* Design Engineer story (#241 phase 2, 2026-11-12, copywriter):
            the in-house staff-level history leads (Gong, Twilio, then Beyond's
            Facebook + Google work), the independent work comes second with
            Eight Angle credited as the whole product, and the signature line
            lands on taste. Links preserved: Gong → gong.io (new tab); Twilio →
            twilio.com (new tab); Eight Angle, Newsroom, Android for Work →
            internal case studies. PENDING Brian (Q1 in the handoff): the
            Twilio design-system credit is not on this page yet. */
          }
          <p>
            I’m a Design Engineer in San Francisco. I’ve led web platforms
            in-house, working day to day with marketing, product, and design. At
            <a href={COMPANIES.gong} target="_blank" rel="noopener">Gong</a> I
            was Staff Web Engineer: I led the site replatform end to end and
            built an LLM translation workflow for it. At <a
              href={COMPANIES.twilio}
              target="_blank"
              rel="noopener">Twilio</a
            > I was Technical Web Lead and shipped the company’s first global
            website and unified CMS. Earlier, at the agency Beyond, I built
            front ends for Facebook, including their <a href="/facebook-newsroom"
              >Newsroom site</a
            >, its first WordPress site and a platform Meta continues to invest
            in today, and <a href="/google-android-for-work"
              >Google’s Android for Work website</a
            >.
          </p>
          <p>
            Now I work independently. I founded <a href="/eight-angle"
              >Eight Angle</a
            > and shipped the whole product myself: the brand, the iOS app, the
            on-device pose classifier I trained, and the App Store listing that
            sells it. I also build sites for clients, taking their own designs
            or existing brand to fast pages they can edit themselves. Taste and
            engineering judgment decide what ships; AI multiplies how much I
            can ship.
          </p>
          {
            /* Closing CTA lives inside .prose on purpose (Brian, 2026-07-22):
            the editorial body face and the accent-green link treatment, not
            the dim mono line it replaced. */
          }
          {
            /* Same behavior as the nav contact item (Brian, 2026-07-22): a
            data-cmd button, so the click rides contactMoment() and plays the
            typed-question emulation on /chat instead of the quieter /contact
            route entry. .cmdlink inherits the prose face and accent link
            treatment, so it reads identically to the anchor it replaced. */
          }
          <p>
            <button type="button" class="cmdlink" data-cmd="contact"
              >Start a conversation <span aria-hidden="true">&#8594;</span></button
            >
          </p>
        </article>
      </main>
    </div>
  </section>
</BaseLayout>
