---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Scene from "@/components/Scene.astro";
import { SITE, LINKS, COMPANIES } from "@/lib/site";

const description =
  "Brian Rohde is an AI Product Engineer in San Francisco who ships full-stack AI products end to end: model, app, and the infrastructure underneath.";

const profilePage = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: SITE.author,
    jobTitle: "AI Product Engineer",
    url: SITE.url,
    sameAs: [LINKS.linkedin, LINKS.x, COMPANIES.eightAngle],
  },
};
---

<BaseLayout title="About" description={description} jsonLd={profilePage}>
  {
    /* interior scene (B2 P3): the persistent gutter scene on the default
    BR identity (#109/#111); content keeps the left column, the wrap
    left-anchors at gutter widths via body:has(.scene) (#125/#126). */
  }
  <Scene />
  <section class="screen" id="scr-about" data-screen="about" tabindex="-1">
    {
      /* B2 Phase 1: the .atop chrome bar ([home] chip + path label) is
        retired; the global header is the one frame on every page. The way
        home is the header wordmark; the page ends clean (Option C,
        2026-07-21) and the global footer follows, matching articles. */
    }
    <div class="wrap artpad">
      <main id="main">
        <h1 class="atitle">About</h1>
        <article class="prose" style="margin-top:0">
          <p>
            I’m an AI Product Engineer in San Francisco. I ship AI products end
            to end: model, app, and the infrastructure underneath.
          </p>
          <p>
            I founded Eight Angle. I <a href="/eight-angle-ml"
              >built a native iOS SwiftUI app with a custom yoga pose detection
              model that runs on-device</a
            >, and trained its 47-class pose classifier to 92.2%
            cross-validated accuracy at roughly 20fps.
          </p>
          <p>
            Before that I was Staff Web Engineer at <a
              href={COMPANIES.gong}
              target="_blank"
              rel="noopener">Gong</a
            >, where I built an LLM translation workflow and replatformed the
            site. At <a href={COMPANIES.twilio} target="_blank" rel="noopener"
              >Twilio</a
            > I was Technical Web Lead and shipped the company’s first global
            website and unified CMS. Earlier, at the agency Beyond, I built
            projects for Facebook, including their <a href="/facebook-newsroom"
              >Newsroom site</a
            >, its first WordPress site and a platform Meta continues to invest
            in today. I also built <a href="/google-android-for-work"
              >Google’s Android for Work website</a
            >.
          </p>
        </article>

        <p class="cco" style="margin-top: 28px">
          <a class="dimlink" href="/contact"
            >Contact me using my AI <span aria-hidden="true">&#8594;</span></a
          >
        </p>
      </main>
    </div>
  </section>
</BaseLayout>
