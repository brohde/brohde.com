---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Scene from "@/components/Scene.astro";
import { LINKS } from "@/lib/site";
import { profilePageLd } from "@/lib/schema";

const description =
  "Brian Rohde is a full-stack engineer in San Francisco shipping AI products end to end: founder of Eight Angle, and a freelance builder delivering client sites through agentic coding workflows.";

const profilePage = profilePageLd();
---

<BaseLayout title="About" description={description} jsonLd={profilePage}>
  {
    /* interior scene (B2 P3): the persistent gutter scene on the default
    BR identity (#109/#111); content keeps the left column, the wrap
    left-anchors at gutter widths via body:has(.scene) (#125/#126). */
  }
  <Scene />
  <section class="screen" id="scr-about" data-screen="about" tabindex="-1">
    {
      /* B2 Phase 1: the .atop chrome bar ([home] chip + path label) is
        retired; the global header is the one frame on every page. The way
        home is the header wordmark; the page ends clean (Option C,
        2026-07-21) and the global footer follows, matching articles. */
    }
    <div class="wrap artpad">
      <main id="main">
        <h1 class="atitle">About</h1>
        <article class="prose" style="margin-top:0">
          {
            /* One merged story (Brian, 2026-07-22): the LinkedIn bio and the
            career detail folded into a single narrative, now → building →
            the career that led here → the signature line. Links preserved:
            Eight Angle → internal; Gong → LinkedIn (new tab); Twilio → the
            SIGNAL piece; Newsroom + Android for Work → internal case studies. */
          }
          <p>
            I’m a full-stack engineer in San Francisco, shipping AI products
            end to end. Today I’m founder of <a href="/eight-angle-ml"
              >Eight Angle</a
            >, an iOS app with a custom-trained on-device ML classifier, and a
            freelance builder delivering client sites through agentic coding
            workflows.
          </p>
          <p>
            Before this I led web platforms, working day to day with marketing,
            product, and design. I was Staff Web Engineer at <a
              href={LINKS.linkedin}
              target="_blank"
              rel="noopener">Gong</a
            >, where I built an LLM translation workflow and replatformed the
            site. At <a href="/twilio-signal-pong">Twilio</a> I was Technical
            Web Lead and shipped the company’s first global website and unified
            CMS. Earlier, at the agency Beyond, I built projects for Facebook,
            including their <a href="/facebook-newsroom">Newsroom site</a>, its
            first WordPress site and a platform Meta continues to invest in
            today. I also built <a href="/google-android-for-work"
              >Google’s Android for Work website</a
            >.
          </p>
          <p>AI multiplies my output; taste and engineering judgment decide what ships.</p>
          {
            /* Closing CTA lives inside .prose on purpose (Brian, 2026-07-22):
            the editorial body face and the accent-green link treatment, not
            the dim mono line it replaced. */
          }
          {
            /* Same behavior as the nav contact item (Brian, 2026-07-22): a
            data-cmd button, so the click rides contactMoment() and plays the
            typed-question emulation on /chat instead of the quieter /contact
            route entry. .cmdlink inherits the prose face and accent link
            treatment, so it reads identically to the anchor it replaced. */
          }
          <p>
            <button type="button" class="cmdlink" data-cmd="contact"
              >Contact me using my AI <span aria-hidden="true">&#8594;</span></button
            >
          </p>
        </article>
      </main>
    </div>
  </section>
</BaseLayout>
