---
import { ClientRouter } from "astro:transitions";
import SEO from "@/components/SEO.astro";
import Analytics from "@/components/Analytics.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { SITE } from "@/lib/site";
import "@/styles/global.css";
// Editorial face (#67/#20): same hashed assets the @font-face rules in
// global.css resolve to; imported here so the preloads below can't drift
// from the CSS. Book + Bold are preloaded (used above the fold on every
// page); Medium loads on demand behind the metric-tuned fallback.
import circularBook from "@/assets/fonts/circular-book.woff2?url";
import circularBold from "@/assets/fonts/circular-bold.woff2?url";

/* ============================================================================
   PERCEIVED-LOAD CONTRACT  (decision #62) — read before adding to the shell.

   The site must paint instantly: static HTML, one inlined stylesheet, nothing
   render-blocking. Everything below protects that first paint. Keep it true;
   measure the built output (dist), not dev.

   What is in the pre-paint critical path, and nothing else:
     1. The HTML document itself.
     2. The inlined stylesheet (build.inlineStylesheets: "always") — one <style>
        in <head>, so paint never waits on a second round-trip.
   Paint is gated by CSS delivery, not by any script. Baseline: FCP ~1.1s, LCP ~1.2s,
   TBT 0, CLS 0 (Lighthouse mobile, gzip). Do not regress these.

   Fonts (#67/#20, license confirmed 2026-07-15): the ONE sanctioned webfont is
   the editorial face, LL Circular Pro — self-hosted woff2 subsets, three
   weights, ~88 KB total, font-display: swap behind a size-adjust'd fallback so
   the swap never shifts layout (CLS 0 measured with fonts live). Preloads are
   async and never block paint. Mono stays system-stack; do not add faces or
   weights without re-measuring Lighthouse on dist.

   What must NEVER enter the pre-paint path:
     - Additional webfonts beyond the editorial face above.
     - Render-blocking <link>/<script> in <head> that isn't the gate.
     - Any fetch/XHR/connection before first paint (chat, analytics beacons).
     - Synchronous work in the body-end module beyond wiring listeners.

   All script is deferred: ClientRouter and the terminal module are type=module
   (implicitly deferred) and never block the parser. Analytics ships only when a
   PostHog key is set and captures nothing before astro:page-load.

   === FACADE PATTERN for future heavy layers (aurora canvas, glyph tide, live
   chat — the #59 integration will consume this) ===
   These are ATMOSPHERE and ENHANCEMENT, never first paint. Each MUST:
     - Render a cheap static facade first (a CSS gradient stand-in for the
       aurora, the already-server-rendered glyph text, a plain prompt for chat).
       The facade is what the user sees "quickly"; the live layer swaps in later.
     - Defer real init to idle/visible: requestIdleCallback (with a setTimeout
       fallback) for atmosphere, IntersectionObserver for per-section tides,
       first-interaction for the live chat model/connection. Never on load.
     - Cost zero bytes on the pre-paint path: lazy-import the heavy module from
       the terminal controller's idle hook; do not add <script>/<link> here.
     - Respect prefers-reduced-motion (freeze/skip animation) and honor the perf
       budget (canvas work off the main thread or throttled; keep TBT ~0, CLS 0).
     - Reserve layout up front so nothing shifts when the live layer arrives
       (reserve the box with visibility/min-size, not display, for this reason).
   Rule of thumb: if a new layer changes FCP/LCP/CLS on the built homepage, it
   is in the wrong place. Put it behind idle/visible/interaction, with a facade.
   ========================================================================== */

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article" | "profile";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const props = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href="/rss.xml"
    />
    <meta name="generator" content={Astro.generator} />

    {
      /* Editorial font preloads (#67/#20): async, non-blocking; crossorigin is
      required on font preloads even same-origin or the fetch is double-keyed
      and re-downloaded. */
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={circularBook}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={circularBold}
      crossorigin
    />

    {/* theme-color follows the ground on both schemes (#40) */}
    <meta
      name="theme-color"
      content="#0E1512"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#FBFBF8"
      media="(prefers-color-scheme: light)"
    />

    <SEO {...props} />

    {
      /*
      Theme gate (#92). Runs before first paint so a stored override never
      flashes the wrong ground: it stamps html[data-theme], which the
      :root[data-theme] blocks in global.css use to beat prefers-color-scheme
      in both directions. No stored value = no attribute = the #40 system
      default, untouched. Deliberately tiny, no network, no dependencies:
      it sits in the pre-paint critical path and must stay cheap (#70).

      The <meta name="theme-color"> pair above is media-scoped and still
      resolves by system preference at this point; theme.ts reconciles it to
      the override once the deferred module runs. That is browser chrome, not
      page paint, so it costs no flash on the surface itself.
    */
    }
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark")
            document.documentElement.setAttribute("data-theme", t);
        } catch (e) {
          /* storage blocked: fall through to the system default */
        }
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="sr">skip to content</a>
    {
      /* The global header (#107/#110/#115/#121): one frame on EVERY page,
      /chat included since B2 Phase 2 (#108), rendered here (like the
      footer) so it can never drift per page. Its .wrap follows the same
      layout law as page content: centered on scene-less pages,
      left-anchored on scene pages (#125/#126). */
    }
    <SiteHeader />
    <slot />
    {
      /* The footer (#91) carries the theme override control (#92) in its row
      since #101; it is no longer a fixed overlay mounted here. On every
      page, /chat included (#108): each page sits on the editorial ground,
      so the control always has something to do. */
    }
    <SiteFooter />
    <Analytics />
    {
      /*
      Single hydration point. One deferred module (type=module) drives every
      interactive behavior; it wires delegated listeners, but does no network
      work and nothing that blocks paint.

      Future heavy layers hang off THIS module's idle hook, never off new tags
      here — see the FACADE PATTERN in the frontmatter. Lazy-import them
      (await import("...")) from an idle/visible/first-interaction callback so
      they stay off the pre-paint path. Adding another <script src>/<link> to
      the shell is the wrong lever; it competes with the critical bytes.
    */
    }
    <script>
      import "@/scripts/terminal.ts";
      import "@/scripts/theme.ts";
    </script>
  </body>
</html>
