---
/**
 * The global site header (#107/#110/#115/#121), built from the D1 shell spec
 * (docs/design/lab/shell-d1.html): ONE frame on every page. Two rows at every
 * width, phones included (#121, no compact control):
 *   row 1  identity: the wordmark "brian rohde" (lowercase, #115) linking
 *          home, carrying the resting caret (#63), with the quiet mono
 *          about/contact tokens beside it (rest dim, hover accent: D1 call 5);
 *   row 2  the chat input row (ChatBar.astro, the one input material).
 *
 * Per-page states, server-stamped here and re-stamped by terminal.ts's
 * syncHeaderChat under every swap (the header is a persisted node, #150, so
 * the caret never stops blinking across a navigation and stale state must
 * be corrected before paint):
 *   data-hchat   the input row hides on the homepage only (#145 amended by
 *                #153/#160: home's input is the flow chat bar in the body);
 *   data-screen  "home" hides the wordmark row and right-aligns the nav
 *                (#160: the body masthead is the name and the h1 there;
 *                interior pages keep the wordmark as chrome + home link),
 *                and "chat" makes the header sticky: the input row IS the
 *                /chat composer (#153 UNIFY).
 *
 * The contact nav item is a button through the same router (#107, chat is
 * core navigation): it opens the chat's contact card, the site's one contact
 * surface. Swap to a mailto if Brian vetoes.
 *
 * BaseLayout renders this on EVERY page. The wordmark is always a <p>: the
 * homepage h1 is the body masthead (#160), interior pages carry their own
 * h1 in main.
 */
import ChatBar from "@/components/ChatBar.astro";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const ownsInput = path === "/";
const screen = path === "/chat" ? "chat" : path === "/" ? "home" : "page";
---

{
  /* transition:persist (#150): the header is the same frame on every page,
  so the node itself survives client-side navigations and the caret is the
  motion system's through-line. Per-page differences (data-hchat,
  data-screen) are re-stamped by syncHeaderChat on astro:after-swap, before
  the new frame paints. */
}
<header
  class="shead"
  data-hchat={ownsInput ? "off" : "on"}
  data-screen={screen}
  transition:persist="shead"
>
  <div class="wrap">
    <div class="idrow">
      <p class="wmrow">
        <a class="wm" href="/">
          brian rohde<span class="caret" aria-hidden="true" />
        </a>
      </p>
      <nav class="snav" aria-label="Site">
        <a href="/about">about</a>
        <button type="button" data-cmd="contact">contact</button>
      </nav>
    </div>
    <ChatBar inputId="in-site" />
  </div>
</header>
