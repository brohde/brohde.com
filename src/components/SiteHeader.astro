---
/**
 * The global site header (#107/#110/#115/#121), built from the D1 shell spec
 * (docs/design/lab/shell-d1.html): ONE frame on every page. Two rows at every
 * width, phones included (#121, no compact control):
 *   row 1  identity: the wordmark "brian rohde" (lowercase, #115) linking
 *          home, carrying the resting caret (#63), with the quiet mono
 *          about/contact tokens beside it (rest dim, hover accent: D1 call 5)
 *          and the theme toggle icon at the far right (item 7);
 *   row 2  the chat input row (ChatBar.astro, the one input material).
 *
 * Per-page states, server-stamped here and re-stamped by terminal.ts's
 * syncHeaderChat under every swap (the header is a persisted node, #150, so
 * the caret never stops blinking across a navigation and stale state must
 * be corrected before paint):
 *   data-hchat   the input row hides on the pages that carry their own chat
 *                input: the homepage (flow chat bar) AND /chat (Phase 4B:
 *                the composer docked into the panel, so the header row is
 *                dropped there too). Interior pages keep the header input as
 *                a jump-to-chat affordance;
 *   data-screen  "home" makes the wordmark the LARGE identity surface (the
 *                page's h1, Phase 4A) with the nav following it, baseline
 *                aligned; interior pages and /chat keep the compact 18px
 *                wordmark as chrome + home link (Phase 4B: /chat reverts to
 *                the standard interior header, no sticky, no page-ground
 *                band).
 *
 * The contact nav item is a button through the same router (#107, chat is
 * core navigation): Phase 4C makes it an LLM moment (lands on /chat and
 * types "How do I contact Brian?"), see terminal.ts.
 *
 * BaseLayout renders this on EVERY page. The wordmark tag follows the page:
 * an <h1> on the homepage (its only h1, Phase 4A) and a <p> everywhere else
 * (interior pages carry their own h1 in main). The server render is correct
 * on a hard load; syncHeaderChat swaps the tag across the persisted node on
 * client-side navigations, before paint (zero CLS).
 */
import ChatBar from "@/components/ChatBar.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHome = path === "/";
// /chat now docks the composer into its panel (Phase 4B), so it hides the
// header input row too, joining the homepage. /contact mirrors the /chat
// surface (the dedicated contact-flow route), so it docks its own composer and
// hides the header row the same way; stamped here server-side so a full
// /contact load never flashes two composers (CLS 0), matching syncHeaderChat.
const ownsInput = isHome || path === "/chat" || path === "/contact";
const screen = path === "/chat" ? "chat" : isHome ? "home" : "page";
const Wm = isHome ? "h1" : "p";
---

{
  /* transition:persist (#150): the header is the same frame on every page,
  so the node itself survives client-side navigations and the caret is the
  motion system's through-line. Per-page differences (data-hchat,
  data-screen, the wordmark tag) are re-stamped by syncHeaderChat on
  astro:after-swap, before the new frame paints. */
}
<header
  class="shead"
  data-hchat={ownsInput ? "off" : "on"}
  data-screen={screen}
  transition:persist="shead"
>
  <div class="wrap">
    <div class="idrow">
      <Wm class="wmrow">
        <a class="wm" href="/">
          brian rohde<span class="caret" aria-hidden="true" />
        </a>
      </Wm>
      <nav class="snav" aria-label="Site">
        <a href="/about">about</a>
        <button type="button" data-cmd="contact">contact</button>
      </nav>
      {
        /* The GitHub mark sits in the far-right icon cluster beside the theme
        toggle (Brian, 2026-07-22) and links straight to the public repo
        (2026-11-12: the build-story article is gone; "view source" in the
        footer is its text twin). The accessible name is the CTA. Quiet icon
        grammar matching .themetgl (rest dim, engage accent); the SVG is decoration (a11y pattern from
        ProfileLinks.astro). This .ghlink owns the margin-left:auto push;
        ThemeToggle no longer carries it. */
      }
      <a
        class="ghlink"
        href="https://github.com/brohde/brohde.com"
        target="_blank"
        rel="noopener"
        aria-label="View source on GitHub"
        title="View source on GitHub"
      >
        <svg
          viewBox="0 0 24 24"
          width="17"
          height="17"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path>
        </svg>
      </a>
      {/* item 7: the theme toggle lives at the far right of the identity row
      (moved out of the footer). It is an icon control; #themectl is theme.ts's
      delegated hook, which survives the persisted header across swaps. */}
      <ThemeToggle />
    </div>
    <ChatBar inputId="in-site" placeholder="Ask Brian’s AI anything" />
  </div>
</header>

<style>
  /* Brian's baseline riders (batch 128): on interior headers the about/contact
     tokens read high against the compact wordmark and the theme icon, which
     already sits on the right line there; seat the nav 2px lower. (The home
     header gets the inverse treatment on the ICON in ThemeToggle.astro: the
     large wordmark pulls the baseline down, the nav is already seated.) */
  .shead:not([data-screen="home"]) .snav {
    transform: translateY(2px);
  }

  /* The GitHub article link: the toggle's exact quiet grammar (44px target,
     rest dim, engage accent) and it now owns the row's right push. */
  .ghlink {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 6px;
    color: var(--dim);
    transition: color 120ms ease;
  }
  .ghlink:hover,
  .ghlink:focus-visible {
    color: var(--accent);
  }
  /* same home-header baseline seating as the theme icon (#180 flag 3) */
  .shead[data-screen="home"] .ghlink {
    transform: translateY(2px);
  }
</style>
