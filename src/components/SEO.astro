---
/**
 * Centralized SEO: title, description, canonical, Open Graph, Twitter, robots,
 * and a JSON-LD slot (E2). Per-page props override the global defaults in
 * SITE. Ported in spirit from the prior-project SEO.astro.
 */
import { SITE, LINKS } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative OG image. Defaults to the site image. */
  image?: string;
  /** Dimensions/type/alt for a per-page image (a glyph card). Emits
      og:image:width/height/type/alt for THIS image, replacing the default
      card's gated block. Omit for images without known metadata (e.g. a video
      poster: og:image alone is fine). */
  imageMeta?: { width: number; height: number; type?: string; alt?: string };
  /** A playable share preview (iMessage/Facebook honor og:video; LinkedIn and
      X ignore it, so the poster stays the universal og:image fallback). */
  video?: { url: string; type?: string; width: number; height: number };
  /** website | article | profile */
  ogType?: "website" | "article" | "profile";
  noindex?: boolean;
  /** Structured data objects; serialized to <script type="application/ld+json">. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  imageMeta,
  video,
  ogType = "website",
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;

// Canonical: build.site + current path, normalized (no trailing slash except root).
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
if (canonicalURL.pathname !== "/") {
  canonicalURL.pathname = canonicalURL.pathname.replace(/\/$/, "");
}
const canonical = canonicalURL.href;
const imageURL = new URL(image, SITE.url).href;
// Same absolute https URL is reused for og:video and og:video:secure_url.
const videoURL = video ? new URL(video.url, SITE.url).href : null;

const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large" />
  )
}

{/* Open Graph */}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageURL} />
{
  /* Dimensions/type/alt for the OG image. A per-page image (glyph card) brings
     its own via imageMeta; otherwise the default card's known metadata is
     gated to the default card only. An image with neither (a video poster)
     emits og:image with no dimension tags, which is fine. */
  imageMeta ? (
    <>
      {imageMeta.type && (
        <meta property="og:image:type" content={imageMeta.type} />
      )}
      <meta property="og:image:width" content={String(imageMeta.width)} />
      <meta property="og:image:height" content={String(imageMeta.height)} />
      {imageMeta.alt && (
        <meta property="og:image:alt" content={imageMeta.alt} />
      )}
    </>
  ) : (
    image === SITE.ogImage && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
          property="og:image:alt"
          content="brian rohde, AI Product Engineer, San Francisco"
        />
      </>
    )
  )
}
{
  /* Video preview (og:video). secure_url reuses the same https URL. */
  video && videoURL && (
    <>
      <meta property="og:video" content={videoURL} />
      <meta property="og:video:secure_url" content={videoURL} />
      <meta property="og:video:type" content={video.type ?? "video/mp4"} />
      <meta property="og:video:width" content={String(video.width)} />
      <meta property="og:video:height" content={String(video.height)} />
    </>
  )
}
<meta property="og:locale" content={SITE.locale} />

{/* Twitter / X */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:creator" content={LINKS.xHandle} />

{
  ldBlocks.map((block) => (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(block)}
    />
  ))
}
