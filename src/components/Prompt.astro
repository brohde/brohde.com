---
/**
 * The command prompt: an input plus its autocomplete popover (#48) and the
 * ghost placeholder with a blinking caret. Reused on the home and chat screens.
 * All behavior (routing, autocomplete, history) lives in terminal.ts, which
 * finds this block by its data-prompt id.
 */
interface Props {
  /** unique key, e.g. "home" | "chat" */
  id: string;
  placeholder?: string;
  label?: string;
}
const {
  id,
  /* Brian's 2026-07-15 review: exact copy. The label matches the visible
     placeholder verbatim so the accessible name always contains what a
     speech-input user sees (label-in-name). */
  placeholder = "Ask me anything or type help",
  label = "Ask me anything or type help",
} = Astro.props;

const inputId = `in-${id}`;
const listId = `ac-list-${id}`;
const acId = `ac-${id}`;
---

<div class="promptzone" data-prompt={id}>
  <div class="ac" id={acId} hidden>
    <p class="ac-head">Commands · tab to accept · ↑↓ to cycle</p>
    <ul
      class="ac-list"
      id={listId}
      role="listbox"
      aria-label="Command suggestions"
    >
    </ul>
  </div>

  <form class="prompt" id={`f-${id}`} data-screen-form>
    <label class="sr" for={inputId}>{label}</label>
    <span class="p" aria-hidden="true">$</span>
    <span class="iwrap">
      <input
        id={inputId}
        name="q"
        type="text"
        role="combobox"
        aria-expanded="false"
        aria-controls={listId}
        aria-autocomplete="list"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        maxlength="240"
        placeholder={placeholder}
        enterkeyhint="send"
      />
      {
        /* ghost placeholder, no caret: the page cursor (#63) rests on the
          wordmark; a caret appears here only while the input is focused */
      }
      <span class="ph" aria-hidden="true">{placeholder}</span>
    </span>
  </form>
</div>
