---
/**
 * The command prompt: an input plus its autocomplete popover (#48) and the
 * ghost placeholder with a blinking caret. Reused on the home and chat screens.
 * All behavior (routing, autocomplete, history, boot typing) lives in
 * terminal.ts, which finds this block by its data-prompt id.
 */
interface Props {
  /** unique key, e.g. "home" | "chat" */
  id: string;
  placeholder?: string;
  label?: string;
  boot?: boolean;
}
const {
  id,
  placeholder = "ask me anything…",
  label = "Ask me anything, or type a command",
  boot = false,
} = Astro.props;

const inputId = `in-${id}`;
const listId = `ac-list-${id}`;
const acId = `ac-${id}`;
---

<div class:list={["promptzone", { bseq: boot }]} data-prompt={id}>
  <div class="ac" id={acId} hidden>
    <p class="ac-head">commands · Tab to accept · ↑↓ to cycle</p>
    <ul
      class="ac-list"
      id={listId}
      role="listbox"
      aria-label="Command suggestions"
    >
    </ul>
  </div>

  <form class="prompt" id={`f-${id}`} data-screen-form>
    <label class="sr" for={inputId}>{label}</label>
    <span class="p" aria-hidden="true">$</span>
    <span class="iwrap">
      <input
        id={inputId}
        name="q"
        type="text"
        role="combobox"
        aria-expanded="false"
        aria-controls={listId}
        aria-autocomplete="list"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        maxlength="240"
        placeholder={placeholder}
        enterkeyhint="send"
      />
      {/* ghost placeholder, no caret: the page cursor (#63) rests on the
          wordmark; a caret appears here only while the input is focused */}
      <span class="ph" aria-hidden="true">{placeholder}</span>
    </span>
  </form>
</div>
