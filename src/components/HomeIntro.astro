---
/**
 * Homepage identity block (Phase 4A): the reading column opens on the role
 * line. The name is the GLOBAL HEADER's wordmark, rendered large on the
 * homepage only (the page's h1, and the resting cursor's home, #63; see
 * SiteHeader). The reading-column masthead that used to lead this block was
 * removed so the header becomes the identity surface. Beneath the role line
 * (with the profile icons inline, #151) sit the settled #77/#79/#80 lines:
 * the founder credit and the companies line (Facebook/Google landing on
 * their case-study proof). The profile links render as monochrome icons
 * (#146; markup + glyph paths live in ProfileLinks.astro).
 *
 * Interim state (Brian's 2026-07-15 review): NO ↗ markers on these links,
 * external or internal; the ledger keeps its ↗ convention (#68). If the
 * markers come back, restore "one affordance per link type" here.
 */
import { COMPANIES, LINKS, logHref } from "@/lib/site";
import ProfileLinks from "@/components/ProfileLinks.astro";

/* The Facebook/Google credits link their case-study pages unconditionally
   (Brian, 2026-07-22): unpublished articles serve image-first stubs (#188),
   so the destinations always exist and no published gate is needed. */
---

<section class="cid" aria-label="Introduction">
  {
    /* The role line is a flex row (a <div>, not a <p>) so the ProfileLinks
      <ul> can sit on it after "San Francisco" (#151): a <ul> is not valid
      inside a <p>. The role text stays one inline unit in .crole-txt so the
      flex row never splits the phrase across items; a matching middot
      (decorative, aria-hidden) separates it from the icon group, which keeps
      its own group label. */
  }
  <div class="crole">
    <span class="crole-txt">
      AI Product Engineer <span class="d">·</span> San Francisco
    </span>
    <span class="d" aria-hidden="true">·</span>
    <ProfileLinks />
  </div>
  {
    /* explicit {" "} spacers: Astro strips whitespace-only text nodes between
      elements, which would fuse "Founder," to the link and eat the middot
      gaps */
  }
  {
    /* The founder credit stays on-site too (Brian, 2026-07-22): the article
      links out to eightangle.com itself, and visitors should learn about
      him here first. */
  }
  <p class="cco">
    Founder,{" "}
    <a href={logHref("eight-angle-ml")}>Eight Angle</a>
  </p>
  {
    /* #162: "(contract)" replaced by "via Beyond": the agency named and
      linked (the #21 no-employment-implication honesty now reads as
      provenance, not a disclaimer). Deliberately QUIET per Brian: the whole
      "via Beyond" wears the note's dim ink and small size (.cnote, 13.5px),
      with "Beyond" a dim underlined link (.dimlink sets only color +
      underline, so nesting the anchor inside the note keeps it the same size
      as "via" while the underline carries the affordance, G183 satisfied;
      dim measures 7.19:1 night / 7.97:1 light). No arrow (#68 interim rule
      for these lines holds). */
  }
  {
    /* Every company credit links its proof (Brian, 2026-07-22): Twilio,
      Facebook, and Google land on their case-study pages; Gong, with no
      article yet, drives to Brian's LinkedIn instead of gong.io ("I would
      rather drive them to my LinkedIn"; the profile carries his tenure,
      the company homepage sells the company). */
  }
  <p class="cco">
    <span class="d">Prev:</span>{" "}
    <a href={LINKS.linkedin} target="_blank" rel="noopener">Gong</a>{" "}
    <span class="d">·</span>{" "}
    <a href={logHref("twilio-signal-pong")}>Twilio</a>{" "}
    <span class="d">·</span>{" "}
    <a href={logHref("facebook-newsroom")}>Facebook</a> +{" "}
    <a href={logHref("google-android-for-work")}>Google</a>{" "}
    <span class="cnote cvia"
      >via{" "}<a
        class="dimlink"
        href={COMPANIES.beyond}
        target="_blank"
        rel="noopener">Beyond</a
      ></span
    >
  </p>
</section>

<style>
  /* Brian (batch 128): "pretty faint but still readable". Steps the #162 note
     down from terminal.css's 80% mix to 65%: night 3.72:1, light 3.30:1,
     past the 3:1 readability floor but deliberately below the 4.5:1 AA text
     line (his explicit call, #184). The underline still marks the link.
     Scoped here so the rule outweighs terminal.css without touching the file
     the Phase A build owns; fold back into terminal.css at the next merge. */
  .cvia,
  .cvia a.dimlink {
    color: color-mix(in srgb, var(--dim) 65%, var(--ground));
  }
  .cvia a.dimlink {
    text-decoration-color: color-mix(in srgb, var(--dim) 65%, var(--ground));
  }
  /* the scoped rules above out-specify terminal.css's hover; restore it */
  .cvia a.dimlink:hover,
  .cvia a.dimlink:focus-visible {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
