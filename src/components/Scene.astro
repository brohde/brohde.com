---
/**
 * The aurora + glyph tide scene, STATIC FACADE stage (#106/#114 via the #70
 * contract). Server-rendered, zero script, aria-hidden, position:fixed: it
 * reserves the whole background layer up front, so the live scene causes no
 * shift when it arrives (CLS 0 by construction). What paints here is a CSS
 * gradient stand-in for the resting home sky plus the pour that keeps the
 * content column's text AA over the scene (see scene.css).
 *
 * The live layer (src/scripts/scene) is lazy-imported from terminal.ts's
 * idle hook; it finds this container by [data-scene], builds the tide canvas
 * and drifting sky inside it, and crossfades them in. transition:persist
 * keeps the live DOM alive across client-side navigations once other pages
 * carry the scene too (#109: one persistent scene, pages swap through the
 * left column).
 *
 * Per-page identity (#111) is parameterized here and read by the module:
 *   placement: "ambient" now; hero (#97/#103) and chat placements later.
 *   theme:     sky palette + tide peak + mark travel identity. Wired on
 *              article pages from frontmatter (B3); themed sky CSS ships
 *              in scene.css (facade) + live.css (slot-scoped crossfade)
 *              for the three lab-designed skies, default sky otherwise.
 *              Client-side navigations travel the PERSISTED scene through
 *              the terminal.ts bridge (this element's dataset is the old
 *              page's); the [data-screen] section carries the fresh stamp.
 *   mark:      the tide's source figure. OMIT to ride the theme's own mark
 *              (THEME_SOURCE in the module; default theme = the BR
 *              letterform, #111 identity plan): the attribute only renders
 *              when a page explicitly overrides, because the module's
 *              mount treats a valid data-scene-mark as the stronger word.
 *   state:     home (cold sky) or chat (golden hour).
 */
interface Props {
  placement?: "ambient";
  theme?:
    | "default"
    | "eight"
    | "news"
    | "android"
    | "atg"
    | "goldcoast"
    | "twilio";
  mark?:
    | "eight"
    | "logo"
    | "pose"
    | "f"
    | "g"
    | "br"
    | "robot"
    | "gccm"
    | "atg"
    | "twilio";
  state?: "home" | "chat";
}
const {
  placement = "ambient",
  theme = "default",
  mark,
  state = "home",
} = Astro.props;
---

<div
  class="scene"
  data-scene
  data-scene-placement={placement}
  data-scene-theme={theme}
  data-scene-mark={mark}
  data-scene-state={state}
  aria-hidden="true"
  transition:persist="scene"
>
  <div class="scn-static"></div>
  <div class="scn-pour"></div>
</div>
