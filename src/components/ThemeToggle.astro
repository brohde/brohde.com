---
/**
 * Theme toggle (#92, items 7 + 8): an ICON control in the site header's
 * identity row (far right, aligned with the wordmark + nav tokens). The site
 * is dark by default (item 8); this is a simple two-state dark/light switch.
 * All state semantics, persistence, and the after-swap re-stamp live in
 * src/scripts/theme.ts. The pre-paint gate in BaseLayout stamps an explicit
 * html[data-theme] ("dark" unless stored "light") before first paint, so the
 * correct icon and label show with no flash.
 *
 * Placement (item 7): rendered by SiteHeader inside .idrow, moved out of
 * SiteFooter. The header is a persisted node (transition:persist="shead"), so
 * this button survives client-side navigations; theme.ts delegates its click
 * on document against #themectl, so the node's position never matters to it.
 *
 * Icon: an inline sun/moon in the site's quiet line style (stroke
 * currentColor, no fill), sized to sit on the nav baseline, resting dim with
 * hover/focus accent exactly like the .snav tokens. Both icons ship; CSS keyed
 * on html[data-theme] shows exactly one (sun while dark = "go light", moon
 * while light = "go dark"), so the visible icon is correct with zero JS.
 *
 * A11y: the accessible name describes the ACTION, server-rendered per state as
 * two sr-only spans keyed on html[data-theme] (display:none drops the inactive
 * one from the accessible name too), so the name is correct from first paint.
 * theme.ts also speaks the new state through its polite region on toggle. No
 * dashes (#18); never the t-word in visitor copy (#116/#58).
 */
---

<button type="button" class="themetgl" id="themectl">
  <span class="tlab tlab-dark sr">Switch to light theme</span>
  <span class="tlab tlab-light sr">Switch to dark theme</span>
  <svg
    class="ticon ticon-sun"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    class="ticon ticon-moon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  /* In the far-right icon cluster (the GitHub .ghlink beside it now owns the
     margin-left:auto push, 2026-07-22); the quiet nav-token grammar (rest dim,
     engage accent). Icon-only: a 44px-tall target, min-width 44px for the
     phone tap, no visible chrome. */
  .themetgl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 6px;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--dim);
    transition: color 120ms ease; /* #150/#165 nav-token easing */
  }
  .themetgl:hover,
  .themetgl:focus-visible {
    color: var(--accent);
  }

  /* Brian's rider (#180 flag 3): on the home header the large wordmark pulls
     the row's text baseline below its vertical center, so the centered icon
     read high. Seat it 2px lower there; interior headers stay centered. */
  :global(.shead[data-screen="home"]) .themetgl {
    transform: translateY(2px);
  }

  /* one icon, keyed on the pre-paint html[data-theme] stamp (always present
     since item 8: "dark" unless stored "light"). Sun while dark (go light),
     moon while light (go dark). */
  .ticon {
    display: none;
  }
  :global(html[data-theme="dark"]) .ticon-sun,
  :global(html[data-theme="light"]) .ticon-moon {
    display: block;
  }

  /* the accessible name follows the same stamp: exactly one sr label stays in
     the tree, so the button's name always describes the current action. */
  .tlab {
    display: none;
  }
  :global(html[data-theme="dark"]) .tlab-dark,
  :global(html[data-theme="light"]) .tlab-light {
    display: inline;
  }
</style>
