---
/**
 * The chat input row: ONE material, three placements (#160 + the
 * chat-surfaces-r1 coherence rule). The global header renders it as the
 * jump-to-chat affordance on interior pages (hidden on the homepage and
 * /chat, which carry their own input); the homepage renders it as the flow
 * chat bar in the reading column; /chat docks it INTO the phosphor panel as
 * the panel's top edge (Phase 4B, class "chatcomposer"). Extracted here so
 * the placements can never drift: same field-well material, same placeholder,
 * same filled send button. Prominence comes from position and seating only
 * (docked / sticky), never a restyle.
 *
 * #194 final design: the row is the shared COMPOSER STRIP (well ground,
 * Circular Book input face, no "$" sigil, #116). Placement dresses it: the
 * /chat composer docks into its panel (bottom hairline, panel-matched
 * corners), while the header + homepage instances wear the MINI CHAT PANEL
 * frame (the panel's border, radius, halo, and focus wake around just the
 * strip). Every placement follows the site theme (night default, daylight
 * paper under light); tokens live in terminal.css.
 *
 * Multi-line auto-grow: the control is a TEXTAREA that rests at one line
 * (rows=1, visually identical to the old single-line field) and grows with
 * content up to a cap, then scrolls internally, so a whole contact message
 * (Phase B) fits comfortably. `field-sizing: content` drives the growth where
 * supported; terminal.ts carries a scrollHeight fallback for the rest. Enter
 * SENDS, Shift+Enter inserts a newline (terminal.ts keydown), because a
 * textarea's native Enter is a newline, not a submit.
 *
 * Composer phase B: maxlength is 2000, the larger of the two endpoint caps
 * (/api/contact accepts a 2000-char message; /api/chat still caps a question
 * at 500 server-side). One shared control, so the field is sized for the
 * contact flow's longer message and a chat question never comes close.
 *
 * Send behavior (#108): the form carries data-screen-form, so terminal.ts's
 * one delegated submit handler routes the value through the one command
 * router. Free-form questions navigate to /chat and auto-ask on arrival
 * (the pendingAfter carry); typed commands (help, about, work...) run
 * deterministically. On /chat a send submits into the conversation in
 * place. action="/chat" is only the no-JS fallback so a raw submit never
 * reloads the current page with ?q=; script always prevents it.
 *
 * The [send] button (composer phase A item 2): a filled accent primary, no
 * brackets (the fill is the affordance, #102/#161). type="submit", so a tap
 * rides the same delegated submit path as Enter (enterkeyhint labels the key).
 * On pages where the row is a jump-to-chat affordance it reads as "send",
 * which is correct.
 */
interface Props {
  /** unique input id per placement, e.g. "in-site" (header), "in-home", "in-chat" */
  inputId: string;
  /** extra form class, e.g. "flowchat" (home) or "chatcomposer" (docked /chat) */
  class?: string;
  /** id of the transcript this composer controls (the docked /chat placement,
      where the log is server-rendered on the same page, so the reference is
      never dangling) */
  ariaControls?: string;
  /** placeholder + accessible label for this placement, per surface (Brian's
      copy call): the header + homepage instances carry identity ("Ask Brian's
      AI anything") since no greeting introduces the chat there; the /chat
      docked composer keeps the terse field instruction (the default), since the
      greeting right below it already introduces the AI. One component, one
      placeholder prop, so the placements never fork. */
  placeholder?: string;
}
const {
  inputId,
  class: cls,
  ariaControls,
  placeholder = "Ask a question, or type help",
} = Astro.props;
---

<form class:list={["hchat", cls]} action="/chat" data-screen-form>
  <label class="sr" for={inputId}>{placeholder}</label>
  <textarea
    id={inputId}
    name="q"
    rows="1"
    autocomplete="off"
    autocapitalize="off"
    autocorrect="off"
    spellcheck="false"
    maxlength="2000"
    placeholder={placeholder}
    enterkeyhint="send"
    aria-controls={ariaControls}></textarea>
  <button type="submit" class="btn-send" aria-label="Send">send</button>
</form>
