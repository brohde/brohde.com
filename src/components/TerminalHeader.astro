---
/**
 * Homepage header, treatment 1: the phosphor wordmark (decision #38).
 * Large mint mono wordmark with glow + CRT scanline texture (night ground),
 * "$ hello" prompt line (#42), whoami bio lines with quiet company links (#39),
 * and the profiles/resume row (#25, #33).
 *
 * .bseq marks blocks the boot sequence reveals in order (#36).
 */
import { LINKS, COMPANIES } from "@/lib/site";
---

<header class="hd">
  <div class="hv1 bseq">
    <p class="pline bseq"><span class="p">$</span> hello</p>
    <h1 class="wordmark bseq">
      brian rohde<span class="caret" aria-hidden="true"></span>
    </h1>
    <p class="bio bseq">full-stack engineer <span class="d">·</span> san francisco</p>
    <p class="bio bseq">
      ships AI products end to end <span class="d">·</span> founder,
      <a class="clink" href={COMPANIES.eightAngle} target="_blank" rel="noopener"
        >eight angle</a
      >
    </p>
    <p class="bio bseq">
      <span class="k">prev:</span>
      <a class="clink" href={COMPANIES.gong} target="_blank" rel="noopener"
        >gong</a
      >
      <span class="d">·</span>
      <a class="clink" href={COMPANIES.twilio} target="_blank" rel="noopener"
        >twilio</a
      >
      <span class="d">·</span>
      <a class="clink" href={COMPANIES.beyond} target="_blank" rel="noopener"
        >beyond</a
      > (projects for facebook + google)
    </p>
  </div>

  <div class="hrow bseq">
    <ul class="links" aria-label="Profiles and resume">
      <li>
        <a class="blink" href={LINKS.linkedin} target="_blank" rel="noopener">
          <span class="br" aria-hidden="true">[</span><span class="lbl"
            >linkedin</span
          ><span class="br" aria-hidden="true">]</span>
        </a>
      </li>
      <li>
        <a class="blink" href={LINKS.resume}>
          <span class="br" aria-hidden="true">[</span><span class="lbl"
            >resume</span
          ><span class="br" aria-hidden="true">]</span>
        </a>
      </li>
      <li>
        <a
          class="blink"
          href={LINKS.x}
          target="_blank"
          rel="noopener"
          title={LINKS.xHandle}
          aria-label={`X, ${LINKS.xHandle}`}
        >
          <span class="br" aria-hidden="true">[</span><span class="lbl">x</span
          ><span class="br" aria-hidden="true">]</span>
        </a>
      </li>
    </ul>
  </div>
</header>
