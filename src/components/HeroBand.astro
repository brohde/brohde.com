---
/**
 * Article hero band (#97/#103): the glyph tide's hero placement as a
 * document-flow object at the top of the article, evolved from the old
 * TideBand facade. The band takes the top 30% of the screen the article
 * opens on, the page ground bleeds up over it from the 20% line (a mask,
 * so the band never reads as a rectangle), and the body's top edge lands
 * at 27.5%, inside the band. Geometry lives in terminal.css (.heroband);
 * the reference frame is a SCREEN, not the document (#103).
 *
 * STATIC FACADE stage (#70 contract): this server-renders a deterministic
 * glyph texture through a ::before custom property, so the texture never
 * exists as document text (nothing for screen readers, reader modes, or
 * find-in-page). Zero script, zero layout shift. The live layer is a
 * SETTLED STILL of the article's mark contain-fit in the band (symbol
 * centered, max height, never cropped, #97), painted once at idle by
 * initHeroBand() in src/scripts/scene/index.ts. Deliberately not animated:
 * the motion spec (#139) gates all new motion; a still ships now.
 *
 * The band sits on the page ground and follows it. Its ink pair is the
 * article theme's tide peak (home state), hex forms of the PEAKS table in
 * src/scripts/scene/index.ts. KEEP IN SYNC with that table; the values are
 * consumed verbatim, never changed here (#135).
 */
interface Props {
  /** seed for the deterministic glyph field, e.g. the article id */
  seed: string;
  /** the article's scene identity (#111); picks the band's ink pair */
  theme?: string;
}
const { seed, theme = "default" } = Astro.props;

/* PEAKS[theme].night[0] / PEAKS[theme].lite[0] from the scene module, as hex */
const PEAK_INK: Record<string, { night: string; lite: string }> = {
  default: { night: "#7ee787", lite: "#086148" },
  eight: { night: "#46c8ae", lite: "#0e7263" },
  news: { night: "#7aa7ff", lite: "#1d4ed8" },
  android: { night: "#3ddc84", lite: "#188038" },
  atg: { night: "#e0d2bd", lite: "#614e37" },
  goldcoast: { night: "#e9ba40", lite: "#885c06" },
  twilio: { night: "#f64e5e", lite: "#ba122a" },
};
const ink = PEAK_INK[theme] ?? PEAK_INK.default;

const BLOCKS = ["░", "▒", "▓", "█"];
const CHARS = "abcdefghijklmnopqrstuvwxyz0123456789";

let h = 2166136261;
for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0 || 1;

const tokens: string[] = [];
for (let i = 0; i < 380; i++) {
  h = (Math.imul(h, 1103515245) + 12345) >>> 0;
  tokens.push(
    BLOCKS[h % BLOCKS.length],
    " ",
    CHARS[(h >>> 8) % CHARS.length] + CHARS[(h >>> 16) % CHARS.length],
    " "
  );
}
const glyphs = tokens.join("");
---

<div
  class="heroband"
  data-hero-band
  data-hero-theme={theme}
  aria-hidden="true"
  style={`--glyphs: "${glyphs}"; --hb-night: ${ink.night}; --hb-lite: ${ink.lite}`}
>
</div>
