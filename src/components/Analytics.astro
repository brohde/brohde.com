---
/**
 * PostHog wiring (E7, decision #11). The project key for the brohde.com
 * PostHog project is committed as the default (Brian, 2026-07-24): phc_ project
 * keys are public by design and ship in the page HTML regardless, so an env
 * var adds a dashboard step without hiding anything. PUBLIC_POSTHOG_KEY still
 * overrides when set (and setting it empty turns analytics off).
 *
 * View Transitions gotcha (verified in prod on the dragan project): with the
 * ClientRouter active, PostHog's automatic $pageview double-counts. Fix here:
 * disable autocapture of pageviews (capture_pageview: false) and fire exactly
 * one $pageview per view from astro:page-load, which runs on the initial load
 * AND after every client-side navigation.
 *
 * The script body is RAW TEXT: Astro does not evaluate JSX expressions inside
 * <script> children, so it must never be wrapped in {`...`} (that shipped
 * literally once and parsed as an inert block + template-literal statement,
 * silently sending nothing, #239). define:vars supplies key/host.
 *
 * The loader fetches array.js from the ASSETS host (us-assets.i.posthog.com),
 * matching the CSP in public/_headers: script-src allows only the assets host;
 * capture POSTs go to the api host, which connect-src allows.
 */
const key =
  import.meta.env.PUBLIC_POSTHOG_KEY ??
  "phc_y9M8bYUJu6oQRUdmRzwzKgYG3pXYwVA8QXjhzDrgWWEL";
const host = import.meta.env.PUBLIC_POSTHOG_HOST ?? "https://us.i.posthog.com";
---

{
  key && (
    <script is:inline define:vars={{ key, host }}>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);

      window.posthog.init(key, {
        api_host: host,
        capture_pageview: false,
        defaults: "2025-05-24",
      });

      // one $pageview per view, on load and on every VT navigation
      document.addEventListener("astro:page-load", function () {
        if (window.posthog) window.posthog.capture("$pageview");
      });
    </script>
  )
}
