---
/**
 * The build.log as a ledger (#67 treatment C): unbracketed mono dates in a
 * fixed column, editorial titles, one hairline per row. Newest first, title +
 * pre-date (#2, #3); descriptions live on the article pages, meta, and RSS.
 * Each entry is a real link to /log/<id> (or the external URL, marked with a
 * never-underlined ↗, #68) so it is crawlable and keyboard reachable; the
 * terminal controller only enhances, never gates, navigation.
 * With `boot`, the head and each row reveal in order as terminal output.
 */
import { getCollection } from "astro:content";
import { logHref, isoDate } from "@/lib/site";

interface Props {
  boot?: boolean;
}
const { boot = false } = Astro.props;

const posts = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<section class="clog" id="log" aria-label="Article log">
  <h2 class="sr">Writing and project log</h2>
  <div class:list={["loghead", { bseq: boot }]}>
    <span>build.log</span><span class="rule" aria-hidden="true"></span>
  </div>
  {
    posts.map((post) =>
      post.data.external ? (
        <a
          class:list={["lentry", { bseq: boot }]}
          href={post.data.external}
          target="_blank"
          rel="noopener"
          aria-label={`${post.data.title} (external, opens in a new tab)`}
        >
          <span class="lts">{isoDate(post.data.date)}</span>
          <span class="lttl">
            {post.data.title}
            <span class="ext" aria-hidden="true">
              &#8599;
            </span>
          </span>
        </a>
      ) : (
        <a class:list={["lentry", { bseq: boot }]} href={logHref(post.id)}>
          <span class="lts">{isoDate(post.data.date)}</span>
          <span class="lttl">{post.data.title}</span>
        </a>
      )
    )
  }
</section>
