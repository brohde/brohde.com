---
/**
 * The log as a ledger (#67 treatment C, unbranded per Brian's 2026-07-15
 * review; restyled per his batch 77 change order): each row is the mono date
 * with the title beneath it in the editorial body voice (normal weight, body
 * size), hairline separators BETWEEN rows only, no frame, no label line (the
 * sr-only heading carries the semantics). Newest first, title + pre-date
 * (#2, #3); descriptions live on the article pages, meta, and RSS.
 * A PUBLISHED entry is a real link to /<id> (#179 bare slugs; or the external URL, marked
 * with a never-underlined ↗, #68) so it is crawlable and keyboard reachable;
 * the terminal controller only enhances, never gates, navigation. Item 11: an
 * unpublished internal entry still LISTS (title + date) but renders as plain
 * text (no anchor: its page 404s) with a quiet [coming soon] status token.
 * External entries stay linked to their off-site URL regardless (they never
 * had a generated page and never 404).
 */
import { getCollection } from "astro:content";
import { logHref, isoDate } from "@/lib/site";

/* Ledger order is (sortDate ?? date) descending; the DISPLAYED date stays
   `date` everywhere below (the pre-dated Facebook piece sits beside its
   sibling without faking its 2014 stamp). */
const orderKey = (d: { sortDate?: Date; date: Date }) =>
  (d.sortDate ?? d.date).valueOf();
const posts = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => orderKey(b.data) - orderKey(a.data)
);

/* #141: external entries show their destination domain with the arrow.
   Derived from the entry's own URL (never hardcoded) so any future
   external entry gets it for free; leading www. stripped for display. */
const domainOf = (url: string) => new URL(url).hostname.replace(/^www\./, "");
---

<section class="clog" id="log" aria-label="Article log">
  <h2 class="sr">Writing and project log</h2>
  {
    posts.map((post) =>
      post.data.external ? (
        <a
          class="lentry"
          href={post.data.external}
          target="_blank"
          rel="noopener"
        >
          <time class="lts" datetime={isoDate(post.data.date)}>
            {isoDate(post.data.date)}
          </time>
          <span class="lttl">
            {post.data.title}
            {/* #141: arrow + destination domain, one non-wrapping unit, small
                and lighter than the title; the arrow stays decoration (#68),
                the domain is real text so AT hears the destination once */}
            <span class="extmark">
              <span class="ext" aria-hidden="true">&#8599;</span>
              <span class="extdom">{domainOf(post.data.external)}</span>
            </span>
            {/* sr suffix instead of an aria-label override, so the accessible
                name always contains the visible text (speech input); the
                visible domain already says "external", so the suffix only
                adds the new-tab behavior */}
            <span class="sr"> (opens in a new tab)</span>
          </span>
        </a>
      ) : (
        /* #188 supersedes the item-11 plain row: unpublished internal entries
           LINK again, to their "Coming soon" stub (the page exists so the
           scene identity travel is live), keeping the quiet [coming soon]
           token; brackets are decoration. */
        <a
          class:list={[
            "lentry",
            { "lentry-soon": !post.data.published },
          ]}
          href={logHref(post.id)}
        >
          <time class="lts" datetime={isoDate(post.data.date)}>
            {isoDate(post.data.date)}
          </time>
          <span class="lttl">
            {post.data.title}
            {!post.data.published && (
              <span class="lsoon">
                <span aria-hidden="true">[</span>coming soon<span
                  aria-hidden="true"
                >]</span>
              </span>
            )}
          </span>
        </a>
      )
    )
  }
</section>
