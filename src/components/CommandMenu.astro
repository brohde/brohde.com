---
/**
 * The visible command menu. Buttons carry data-cmd; the terminal controller
 * (terminal.ts) delegates clicks to run them. Also fully reachable by Tab.
 */
interface Props {
  /** commands to show, in order */
  items?: string[];
  /** aria-label for the nav landmark */
  label?: string;
}
const {
  items = ["work", "about", "resume", "contact"],
  label = "Commands",
} = Astro.props;
---

<nav class="menu" aria-label={label}>
  {
    items.map((cmd) => (
      <button type="button" class="cbtn" data-cmd={cmd}>
        <span class="br" aria-hidden="true">
          [
        </span>
        <span class="lbl">{cmd}</span>
        <span class="br" aria-hidden="true">
          ]
        </span>
      </button>
    ))
  }
</nav>
